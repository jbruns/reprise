#!/usr/bin/env bash
# Builds .retool/ (or the folder given): the patched Retool with its pinned clone lists, the pristine
# Retool for the patch-neutrality test, and a Python 3.11 venv from the hash-locked requirements.
# Point TITLE_SELECT_RETOOL at the folder; cargo does so for the default one.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
dest="${1:-$root/.retool}"
mkdir -p "$dest"
uv venv --quiet --allow-existing --python 3.11 "$dest/venv"
uv pip sync --quiet --python "$dest/venv/bin/python" --require-hashes "$root/third_party/retool/requirements.txt"
"$dest/venv/bin/python" "$root/tools/retool/build.py" build --dest "$dest"
echo "Retool for Selection is ready in $dest"
