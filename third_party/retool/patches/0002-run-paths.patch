+    # Patched: data folders given on the command line replace the install's own.
+    for path_attribute, location in (
+        ('path_clone_list', config.user_input.user_clone_list_location),
+        ('path_metadata', config.user_input.user_metadata_location),
+        ('path_mia', config.user_input.user_mia_location),
+        ('path_ra', config.user_input.user_ra_location),
+    ):
+        if location:
+            setattr(config, path_attribute, pathlib.Path(location))
