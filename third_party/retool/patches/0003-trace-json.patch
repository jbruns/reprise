+    json_group_names: dict[str, set[str]] = {}
+    json_seen: dict[str, str] = {}
+    json_pending: dict[str, Any] | None = None
+    json_metadata: set[str] = set()
+    json_clone_list_unmatched: set[str] = set()
+
+    @staticmethod
+    def json_open(path: str) -> None:
+        """Opens the --trace-json sink."""
+        TraceTools.json_sink = open(path, 'w', encoding='utf-8')  # noqa: SIM115
+
+    @staticmethod
+    def json_context(stage: str | None = None, group: str = '', scope: str = '') -> None:
+        """Sets the stage, group and scope that the next trace records belong to."""
+        if stage is not None:
+            TraceTools.json_stage = stage
+        TraceTools.json_group = group
+        TraceTools.json_scope = scope
+
+    @staticmethod
+    def json_write(record: dict[str, Any]) -> None:
+        """Writes one record to the --trace-json sink, after any pending step."""
+        TraceTools.json_flush()
+        record['schema'] = TraceTools.JSON_SCHEMA_VERSION
+        TraceTools.json_sink.write(json.dumps(record, ensure_ascii=False, sort_keys=True) + '\n')
+
+    @staticmethod
+    def json_flush() -> None:
+        """Writes the pending step record, once nothing more can be added to it."""
+        record = TraceTools.json_pending
+        TraceTools.json_pending = None
+
+        if record is not None:
+            TraceTools.json_write(record)
+
+    @staticmethod
+    def json_plain(text: Any) -> str:
+        """Removes console formatting from trace text."""
+        return re.sub('\x1b(?:\\[[0-9;?]*[A-Za-z]|M)', '', str(text)).strip()
+
+    @staticmethod
+    def json_record_titles(processed_titles: dict[str, set[DatNode]]) -> None:
+        """Remembers every title Retool starts with, to account for each one at the end."""
+        for group, titles in processed_titles.items():
+            for title in titles:
+                TraceTools.json_seen.setdefault(title.full_name, group)
+
+    @staticmethod
+    def json_resolve(text: str, group: str) -> str | None:
+        """Finds the title name a line of trace text ends with."""
+        candidates: set[str] = TraceTools.json_group_names.get(group, set())
+        matches: list[str] = [x for x in candidates if text.endswith(x)]
+
+        if not matches:
+            matches = [x for x in TraceTools.json_seen if text.endswith(x)]
+
+        return max(matches, key=len) if matches else None
+
+    @staticmethod
+    def json_note(text: Any) -> None:
+        """
+        Adds a line that Retool would have printed under a trace message to that
+        message's record, as a kept or removed title where the line says so.
+        """
+        record = TraceTools.json_pending
+
+        if record is None:
+            return
+
+        line: str = TraceTools.json_plain(text)
+
+        if not line:
+            return
+
+        # A progress line ends the message, rather than adding to it.
+        if re.match(r'• [A-Z][a-z]+ing\b.*\.\.\.( done\.?)?$', line) or line == '• Trace complete.':
+            TraceTools.json_flush()
+            return
+
+        for prefix, field in (('+ Keeping:', 'kept'), ('- Removing:', 'removed')):
+            if line.startswith(prefix):
+                name = TraceTools.json_resolve(line[len(prefix) :].strip(), record['group'])
+                if name is not None:
+                    record[field].append(name)
+
+        record['details'].append(line)
+
+    @staticmethod
+    def json_step(
+        trace_reference: str,
+        message: str,
+        variable: list[str],
+        title_set: set[DatNode],
+        keep_remove: bool,
+    ) -> None:
+        """Starts the record for one trace_title call."""
+        # A call without a reference continues the previous message.
+        if not trace_reference and TraceTools.json_pending is not None:
+            if keep_remove and len(variable) >= 2:
+                TraceTools.json_note(f'+ Keeping: {variable[0]}')
+                TraceTools.json_note(f'- Removing: {variable[1]}')
+            else:
+                TraceTools.json_pending['variables'].extend(
+                    TraceTools.json_plain(x) for x in variable
+                )
+            return
+
+        names: list[str] | None = None
+        group: str = TraceTools.json_group
+
+        if title_set:
+            names = sorted({title.full_name for title in title_set})
+            if not group:
+                group_names = {title.group_name for title in title_set}
+                if len(group_names) == 1:
+                    group = next(iter(group_names))
+
+        key = (TraceTools.json_stage, group, TraceTools.json_scope)
+
+        # Other stages handle one title at a time, in set order, so only a
+        # selection stage's snapshots follow on from each other.
+        chained: bool = TraceTools.json_stage in (
+            'Parent selection',
+            'Superset parent selection',
+            'Compilation parent selection',
+            'Compilations',
+        )
+
+        record: dict[str, Any] = {
+            'type': 'step',
+            'stage': TraceTools.json_stage,
+            'group': group,
+            'scope': TraceTools.json_scope,
+            'ref': trace_reference,
+            'message': TraceTools.json_plain(message),
+            'before': TraceTools.json_snapshots.get(key) if chained else None,
+            'after': names,
+            'kept': [],
+            'removed': [],
+            'variables': [],
+            'details': [],
+        }
+
+        if names is not None:
+            if chained:
+                TraceTools.json_snapshots[key] = names
+            TraceTools.json_group_names.setdefault(group, set()).update(names)
+
+        TraceTools.json_flush()
+        TraceTools.json_pending = record
+
+        if keep_remove and len(variable) >= 2:
+            TraceTools.json_note(f'+ Keeping: {variable[0]}')
+            TraceTools.json_note(f'- Removing: {variable[1]}')
+            record['details'] = []
+        else:
+            record['variables'] = [TraceTools.json_plain(x) for x in variable]
+
+    @staticmethod
+    def json_run(system: str, clone_list: bool, metadata: dict[str, Any]) -> None:
+        """Writes the record of what Retool runs with: the system name it looks data up by."""
+        TraceTools.json_metadata = set(metadata)
+        TraceTools.json_write(
+            {
+                'type': 'run',
+                'system': system,
+                'clone_list': clone_list,
+                'metadata': bool(metadata),
+            }
+        )
+
+    @staticmethod
+    def json_final(processed_titles: dict[str, set[DatNode]], removed_titles: Removes) -> None:
+        """Writes one record per group and one per excluded title, then closes the sink."""
+        kept: set[str] = set()
+
+        for group, titles in sorted(processed_titles.items()):
+            numbered: dict[str, str] = {x.numbered_name: x.full_name for x in titles}
+            kept.update(x.full_name for x in titles)
+            TraceTools.json_write(
+                {
+                    'type': 'group',
+                    'group': group,
+                    'parents': sorted(x.full_name for x in titles if not x.cloneof),
+                    'clones': {
+                        x.full_name: numbered.get(x.cloneof, x.cloneof)
+                        for x in sorted(titles, key=lambda x: x.full_name)
+                        if x.cloneof
+                    },
+                }
+            )
+
+        excluded: dict[str, dict[str, Any]] = {}
+
+        for list_name, titles in sorted(vars(removed_titles).items()):
+            for title in sorted(titles, key=lambda x: x.full_name):
