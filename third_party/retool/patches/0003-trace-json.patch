 class TraceTools:
     """Tools to trace a title's progress throughout Retool."""
 
+    # Patched: a JSON Lines sink for --trace-json. When it's open, every group is traced
+    # into it and nothing is traced to the console.
+    JSON_SCHEMA_VERSION: int = 1
+    json_sink: Any = None
+    json_stage: str = ''
+    json_group: str = ''
+    json_scope: str = ''
