+                        'group': title.group_name,
+                        'list': list_name,
+                        'reason': title.exclude_reason,
+                    }
+
+        for name, group in sorted(TraceTools.json_seen.items()):
+            if name not in kept and name not in excluded:
+                excluded[name] = {
+                    'type': 'excluded',
+                    'title': name,
+                    'group': group,
+                    'list': None,
+                    'reason': '',
+                }
+
+        for record in excluded.values():
+            TraceTools.json_write(record)
+
+        TraceTools.json_write(
+            {
+                'type': 'coverage',
+                'clone_list_unmatched': sorted(TraceTools.json_clone_list_unmatched),
+                'metadata_missing': sorted(
+                    x for x in TraceTools.json_seen if x not in TraceTools.json_metadata
+                ),
+            }
+        )
+
+        TraceTools.json_flush()
+        TraceTools.json_sink.close()
+        TraceTools.json_sink = None
+
